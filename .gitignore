node_modules/

# 日志与本地调试产物
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# 本地打包 / 覆盖率产物
*.tgz
coverage/
.nyc_output/

# Java 本地编译产物
*.class

# 编辑器与操作系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# 本地环境变量与凭据
.env
.env.*
!.env.example

