{
  "name": "mk-emoji-picker",
  "version": "2.0.0",
  "description": "A zero-dependency custom emoji picker for textarea and contenteditable, with emoticon-code parsing.",
  "type": "module",
  "main": "./dist/mk-emoji-picker.cjs",
  "module": "./dist/mk-emoji-picker.esm.js",
  "unpkg": "./dist/mk-emoji-picker.js",
  "jsdelivr": "./dist/mk-emoji-picker.js",
  "style": "./dist/mk-emoji-picker.css",
  "exports": {
    ".": {
      "import": "./dist/mk-emoji-picker.esm.js",
      "require": "./dist/mk-emoji-picker.cjs"
    },
    "./emoji-list": {
      "import": "./dist/emoji-list.esm.js",
      "require": "./dist/emoji-list.cjs"
    },
    "./style.css": "./dist/mk-emoji-picker.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "server",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "node --test test/api.test.js test/layout.test.js test/lazyload.test.js test/page.test.js test/parse.test.js test/server.test.js",
    "check": "npm run lint && npm test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "emoji",
    "emoji-picker",
    "emoticon",
    "smiley",
    "sticker",
    "custom-emoji",
    "textarea",
    "contenteditable",
    "vanilla-js",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mengkunsoft/mk-emoji-picker.git"
  },
  "homepage": "https://github.com/mengkunsoft/mk-emoji-picker#readme",
  "bugs": {
    "url": "https://github.com/mengkunsoft/mk-emoji-picker/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1"
  }
}
